              "host": ["{{base_url}}"],
              "path": ["api", "v1", "emergency", "status"]
            }
          }
        },
        {
          "name": "Biometric verify (signs its own assertion)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Reproduces the Flutter client's signature exactly:",
                  "//   guardfi-biometric-v1|<userId>|true|<verifiedAtEpochMs>|<nonce>",
                  "const CryptoJS = require('crypto-js');",
                  "const secret = pm.environment.get('biometric_secret');",
                  "const userId = pm.environment.get('user_id') || pm.collectionVariables.get('user_id');",
                  "if (!secret || secret === 'replace-with-BIOMETRIC_SHARED_SECRET') {",
                  "  console.log('Set biometric_secret to the server BIOMETRIC_SHARED_SECRET before running this request.');",
                  "} else {",
                  "  const verifiedAt = new Date().toISOString();",
                  "  const nonce = CryptoJS.lib.WordArray.random(18).toString(CryptoJS.enc.Hex);",
                  "  const canonical = 'guardfi-biometric-v1|' + userId + '|true|' + Date.parse(verifiedAt) + '|' + nonce;",
                  "  const signature = CryptoJS.HmacSHA256(canonical, secret).toString(CryptoJS.enc.Hex);",
                  "  pm.environment.set('bio_verified_at', verifiedAt);",
                  "  pm.environment.set('bio_nonce', nonce);",
                  "  pm.environment.set('bio_signature', signature);",
                  "}"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('emergency mode unlocked (200/201)', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "pm.test('the audit row is referenced', function () {",
                  "  pm.expect(pm.response.json().data.audit.id).to.be.a('string');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"success\": true,\n  \"verifiedAt\": \"{{bio_verified_at}}\",\n  \"nonce\": \"{{bio_nonce}}\",\n  \"signature\": \"{{bio_signature}}\",\n  \"deviceMetadata\": {\n    \"deviceId\": \"postman-demo-device\",\n    \"platform\": \"android\",\n    \"appVersion\": \"1.0.0\",\n    \"model\": \"Postman Runner\"\n  }\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/emergency/biometric-verify",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "emergency", "biometric-verify"]
            }
          }
        },
