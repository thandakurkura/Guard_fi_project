      "item": [
        {
          "name": "Health check",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('API healthy (200)', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('database connected and indexes ready', function () {",
                  "  pm.expect(body.data.database.connected).to.be.true;",
                  "  pm.expect(body.data.database.indexesReady).to.be.true;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        },
        {
          "name": "API index (mounted modules)",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('v1 index answers (200)', function () { pm.response.to.have.status(200); });",
                  "pm.test('every module is mounted', function () {",
                  "  const modules = pm.response.json().data.mountedModules;",
                  "  ['auth','nominees','sos','analytics','shield-pay','scam-buster','emergency','config'].forEach(function (name) {",
                  "    pm.expect(modules).to.include(name);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/v1", "host": ["{{base_url}}"], "path": ["api", "v1"] }
          }
        }
      ]
    },
    {
      "name": "01 · Auth (OTP login)",
      "item": [
        {
          "name": "Send OTP",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OTP issued (200)', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "if (body.data && body.data.otp) {",
                  "  pm.environment.set('dev_otp', body.data.otp);",
                  "  console.log('OTP_DEV_MODE is on — captured the code for the next request.');",
                  "} else {",
                  "  console.log('OTP was sent by SMS; read it from the phone and paste it into {{dev_otp}}.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"phone\": \"{{demo_phone}}\"\n}" },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/send-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "send-otp"]
            }
          }
        },
        {
          "name": "Verify OTP (captures jwt_token)",
          "auth": { "type": "noauth" },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('signed in (200)', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('a JWT came back', function () { pm.expect(body.data.token).to.be.a('string'); });",
                  "pm.environment.set('jwt_token', body.data.token);",
                  "pm.environment.set('user_id', body.data.user._id);",
                  "pm.collectionVariables.set('jwt_token', body.data.token);",
                  "pm.collectionVariables.set('user_id', body.data.user._id);",
                  "console.log('Captured jwt_token and user_id for every later request.');"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"{{demo_phone}}\",\n  \"otp\": \"{{dev_otp}}\",\n  \"name\": \"Aarav Sharma\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/auth/verify-otp",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "auth", "verify-otp"]
            }
          }
        }
      ]
    },
