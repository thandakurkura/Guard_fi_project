{
  "info": {
    "_postman_id": "b1f0c6d2-9a4e-4f7b-8c31-0d5e7a2b6f44",
    "name": "GuardFi Backend — Complete API",
    "description": "Every GuardFi module, in the order a demo should run. Import alongside GuardFi.postman_environment.json, then run folders top to bottom: Auth stores {{jwt_token}}, SOS stores {{alert_id}}, Shield Pay stores {{check_id}}, Scam Buster stores {{scan_id}}. The emergency folder signs its own biometric assertion with crypto-js using {{biometric_secret}}.",
