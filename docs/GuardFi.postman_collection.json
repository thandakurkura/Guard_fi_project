                "type": "text/javascript",
                "exec": [
                  "pm.test('verdict returned (200)', function () { pm.response.to.have.status(200); });",
                  "const body = pm.response.json();",
                  "pm.test('the seeded scam handle is DANGER', function () { pm.expect(body.data.riskLevel).to.eql('DANGER'); });",
                  "pm.test('the warning is bilingual', function () {",
                  "  pm.expect(body.data.msg_en).to.be.a('string');",
                  "  pm.expect(body.data.msg_hi).to.match(/[\\u0900-\\u097F]/);",
                  "});",
                  "if (body.data.checkId) { pm.environment.set('check_id', body.data.checkId); }"
                ]
