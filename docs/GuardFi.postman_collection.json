  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Nothing global to prepare; each folder captures what the next one needs."
        ]
      }
    }
  ],
  "variable": [
    { "key": "jwt_token", "value": "" },
    { "key": "user_id", "value": "" }
  ],
  "item": [
