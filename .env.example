# ============================================================================
# GuardFi backend — environment template
# Copy to `.env` and fill in real values:  cp .env.example .env
# ============================================================================

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=3000

# Whose IP Express believes, which is what every per-IP rate limit is keyed on.
#   false → trust the socket only. Correct for local dev and any directly
#           reachable server.
#   1     → trust the first X-Forwarded-For hop. ONLY correct when a proxy you
#           control (Render/Railway) sits in front and OVERWRITES the header.
# SECURITY: with 1 on a directly reachable server, anyone can send a different
# X-Forwarded-For per request and get a fresh rate-limit bucket every time,
# bypassing the OTP and sign-in limits entirely.
TRUST_PROXY=false

# Log verbosity: error | warn | info | debug
LOG_LEVEL=debug

# ---------------------------------------------------------------------------
# Database (Phase 1 — REQUIRED, hard fail if missing)
# MongoDB Atlas connection string. Local example: mongodb://127.0.0.1:27017/guardfi
# Atlas example: mongodb+srv://USER:PASS@cluster0.xxxxx.mongodb.net/guardfi?retryWrites=true&w=majority
#
# Copy the whole URI from Atlas → Connect → Drivers, and keep the database name
# in the path. If the path is empty ("...mongodb.net/?retryWrites=true") the
# driver would write to a database called "test"; GuardFi therefore falls back to
# MONGO_DB_NAME below instead.
#
# Only UNCOMMENTED lines count. A credential left behind a "#" is inert — the
# classic "I pasted my password but it still cannot connect" trap, since dotenv
# treats comments as comments.
#
# If a password contains @ : / ? # % or &, percent-encode it here
# (@ → %40, / → %2F, : → %3A, # → %23, ? → %3F, & → %26, % → %25).
#
# ATLAS REJECTED THE CONNECTION? If startup logs "MongooseServerSelectionError"
# or a TLS alert, the credentials are usually fine: this machine's public IP is
# not on the cluster's access list. Add it at cloud.mongodb.com → your project →
# Security → Network Access → Add IP Address → Add Current IP Address.
# Run `npm run diagnose:atlas` to see the exact failing layer (DNS / TCP / TLS).
# ---------------------------------------------------------------------------
MONGO_URI=
# Database used when MONGO_URI does not name one. Also sent as the driver's
# dbName, so a stray double slash ("…net//guardfi") cannot create an invalid one.
MONGO_DB_NAME=guardfi
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=2
MONGO_CONNECT_RETRIES=3
MONGO_RETRY_BASE_DELAY_MS=1000
MONGO_SERVER_SELECTION_TIMEOUT_MS=8000

# ---------------------------------------------------------------------------
# Auth (Phase 1 — REQUIRED). JWT_SECRET must be at least 32 characters.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ---------------------------------------------------------------------------
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# HTTP surface
# ---------------------------------------------------------------------------
# Comma-separated allow-list. Use * only for local/hackathon development.
CORS_ORIGINS=*
JSON_BODY_LIMIT=1mb
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
# OTP sending gets its own budget because every request costs a real SMS.
RATE_LIMIT_OTP_MAX=5
RATE_LIMIT_OTP_WINDOW_MS=900000
# Limiters are always skipped under NODE_ENV=test. Set this to false only when a
# harness must prove a real 429 (scripts/verify-phase2.js does exactly that).
RATE_LIMIT_SKIP_IN_TEST=true
SHUTDOWN_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# Phase 2 — phone identity, OTP login & SMS delivery
# ---------------------------------------------------------------------------
# Country code assumed when a user types a number without "+" (10-digit local
# numbers are read as <DEFAULT_PHONE_COUNTRY_CODE><number>).
DEFAULT_PHONE_COUNTRY_CODE=91

# true  → /send-otp returns the code in the JSON response instead of texting it.
#         Defaults to true outside production and false in production.
#         With NODE_ENV=production this REFUSES TO BOOT unless the override below
#         is set, because returning live OTPs is a full account-takeover primitive.
OTP_DEV_MODE=true
# Only for a deliberate, temporary production demo. Leave it out in real deploys.
ALLOW_OTP_DEV_MODE_IN_PRODUCTION=false
OTP_LENGTH=6
# A MongoDB TTL index expires codes after this many seconds. Changing this value
# needs the `createdAt_1` index on the `otps` collection rebuilt: MongoDB cannot
# alter expireAfterSeconds in place (development rebuilds it automatically).
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
# Minimum seconds between two /send-otp calls for the SAME number (anti SMS bomb).
# 0 disables the cooldown.
OTP_RESEND_COOLDOWN_SECONDS=30
# Hard cap on codes per phone per window — the control that survives an attacker
# rotating IP addresses, since the per-IP limiter does not. 0 disables the cap.
OTP_MAX_SENDS_PER_WINDOW=10
OTP_SEND_WINDOW_SECONDS=3600
OTP_HASH_ROUNDS=8
BCRYPT_SALT_ROUNDS=10

# auto → Twilio when all three of its values are present, else Fast2SMS, else
# nothing. Pin it to twilio | fast2sms | none to make a misconfiguration loud
# instead of silent. Delivery failure with OTP_DEV_MODE=false returns 503.
SMS_PROVIDER=auto
SMS_HTTP_TIMEOUT_MS=10000
# 'otp' uses Fast2SMS's pre-approved OTP template, 'q' sends a quick message.
FAST2SMS_ROUTE=otp

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
FAST2SMS_API_KEY=

# ---------------------------------------------------------------------------
# Phase 3 — nominees / guardians
# ---------------------------------------------------------------------------
# Maximum guardians one account may store. Enforced server-side (including
# under concurrent adds) and returned to the client as `maxNominees`.
MAX_NOMINEES_PER_USER=5

# ---------------------------------------------------------------------------
# Socket.io connection budget (Phase 1 transport)
# ---------------------------------------------------------------------------
# Every open socket costs memory and a file descriptor, and Socket.io is mounted
# before Phase 4 adds handshake authentication. These caps stop an unauthenticated
# client opening connections until the process or the platform gives up.
# Set either to 0 to disable that half of the guard.
SOCKET_MAX_CONNECTIONS_PER_IP=25
SOCKET_MAX_CONNECTIONS=2000

# ---------------------------------------------------------------------------
# Phase 4 — SOS alerts, live location & push notifications
# ---------------------------------------------------------------------------
# A GPS stream is persisted at most once per this many seconds. Faster updates
# are broadcast live over Socket.io from RAM and skipped for the database, so a
# phone sending 10 positions/second cannot turn into 10 writes/second.
SOS_LOCATION_PERSIST_INTERVAL_SECONDS=5
# Breadcrumbs retained per alert; older points are sliced off atomically.
SOS_LOCATION_HISTORY_LIMIT=200
# Text guardians without a usable push token (or whose push failed).
SOS_SMS_FALLBACK_ENABLED=true
# Per-socket cap on location_update messages, per second.
SOS_MAX_LOCATION_UPDATES_PER_SECOND=5
# Optional deep link appended to the fallback SMS as ?room=<roomId>.
SOS_TRACKING_BASE_URL=

# Firebase service account (all three or none). Without them the API reports
# push as "not_configured" and relies on the SMS fallback.
# FIREBASE_PRIVATE_KEY keeps its literal \n escapes: the app converts them.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ---------------------------------------------------------------------------
# Phase 5 — dashboard analytics
# ---------------------------------------------------------------------------
# Default radius for the "alerts near me" $geoNear aggregate (100–50000 m).
# Clients may override per request with ?radiusMeters=; the same bounds apply.
ANALYTICS_NEARBY_RADIUS_METERS=5000
# Default window for global "recent SOS" counts (1–168 h), overridable with
# ?windowHours=. Both are bounded so a dashboard refresh cannot become a
# collection-wide scan.
ANALYTICS_RECENT_WINDOW_HOURS=24

# ---------------------------------------------------------------------------
# Phase 6 — Shield Pay (UPI fraud detection)
# ---------------------------------------------------------------------------
# Risk bands for the 0-100 payee score. Heuristic pattern checks are capped
# below SHIELD_PAY_DANGER_THRESHOLD by design: only a curated/reported entity
# can produce a "Fraud Alert". The danger band must be strictly above the
# suspicious band or the app refuses to boot (an inverted band would make every
# scam payee read as merely "suspicious").
SHIELD_PAY_SUSPICIOUS_THRESHOLD=30
SHIELD_PAY_DANGER_THRESHOLD=70
# How long the server-side "you were warned" state (checkId) stays valid, in
# seconds. After it expires the payee must be checked again before the user can
# accept the warning — consent to a stale warning is not consent.
SHIELD_PAY_RISK_CHECK_TTL_SECONDS=900
# Largest single payment, in rupees.
SHIELD_PAY_MAX_AMOUNT=200000
# PIN attempts per window on /proceed-transaction and /set-pin. A 4-6 digit PIN
# is a 10 000-guess space, so this budget is deliberately small.
RATE_LIMIT_PIN_MAX=10

# ---------------------------------------------------------------------------
# Phase 7 — Scam Buster (Gemini AI + Cloudinary screenshot storage)
# ---------------------------------------------------------------------------
# Google AI Studio key: https://aistudio.google.com/apikey
# Without it, POST /api/v1/scam-buster/analyze still answers 201: the scan is
# screened by the deterministic offline heuristics (analysisSource=HEURISTIC,
# fallbackReason=AI_NOT_CONFIGURED) instead of failing. A key upgrades every scan
# to real AI analysis. The boot log says which mode is active.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Hard deadline for one generation, enforced by the SDK and by a race on top of
# it, so a stalled provider can never hold a request open.
GEMINI_TIMEOUT_MS=15000

# Cloudinary (Dashboard → Product Environment Credentials). All three values or
# none: without them, screenshots are stored on local disk (imageStorage=LOCAL)
# and analysis is unaffected — the screenshot is analysed from memory.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=guardfi/scam-scans
CLOUDINARY_TIMEOUT_MS=20000

# Screenshot size cap (bytes) and text length cap (characters). A screenshot is
# a phone screen, not a RAW photo: bytes are paid for twice, on upload and in AI
# input tokens.
SCAM_BUSTER_MAX_IMAGE_BYTES=5242880
SCAM_BUSTER_TEXT_MAX_CHARS=5000

# Where screenshots go when Cloudinary is not configured.
#   auto       → Cloudinary when its credentials are present, else local disk (default)
#   cloudinary → require Cloudinary; the server refuses to boot without credentials
#   local      → always local disk, even with Cloudinary configured
SCAM_BUSTER_STORAGE_MODE=auto
# Relative paths resolve against the process working directory. Local storage is
# ephemeral on most deployed hosts — use Cloudinary for production.
SCAM_BUSTER_LOCAL_STORAGE_DIR=uploads/scam-scans
# If the local write itself fails (read-only filesystem, full disk), a screenshot
# up to this size is inlined into MongoDB as a data URI instead. 1 MB keeps the
# document far below the 16 MB limit after base64 inflation.
SCAM_BUSTER_INLINE_IMAGE_MAX_BYTES=1048576

# Every scan spends AI quota, so the endpoint gets its own budget.
RATE_LIMIT_SCAM_BUSTER_MAX=20

# ---------------------------------------------------------------------------
# Phase 8 — Emergency biometric bypass & immutable audit trail
# ---------------------------------------------------------------------------
# Shared HMAC key between this server and the Flutter build. After the device
# verifies a fingerprint / face locally it signs
#
#   guardfi-biometric-v1|<userId>|true|<verifiedAtEpochMs>|<nonce>
#
# with HMAC-SHA256 and POSTs the hex digest as `signature`. The server checks the
# HMAC, the timestamp and the single-use nonce before it unlocks emergency mode.
#
# Generate a key (32 bytes → 64 hex characters):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Ship the SAME value inside the app build. Empty (or shorter than 32 chars) means
# POST /api/v1/emergency/biometric-verify answers 503 instead of trusting an
# unsigned `{"success": true}` from the wire. This is defence in depth, not
# hardware attestation: a rooted device can extract an embedded key.
BIOMETRIC_SHARED_SECRET=
# How old a signed result may be, in seconds. Short on purpose: proof captured
# yesterday is not a finger on the sensor now.
BIOMETRIC_MAX_ASSERTION_AGE_SECONDS=120
# Unlock attempts per IP per window. Each accepted or rejected attempt writes an
# immutable AuditLog row, so this is also what stops the collection being flooded.
RATE_LIMIT_EMERGENCY_MAX=10

# ---------------------------------------------------------------------------
# Phase 9 — Dynamic global configuration (public GET, admin PUT)
# ---------------------------------------------------------------------------
# The AppConfig singleton is auto-seeded with defaults on the first request and
# then served from node-cache for this many seconds. The admin PUT
# (PUT /api/v1/config/global) deletes the cache entry immediately, so the TTL is
# only a safety net for a missed invalidation. GET /api/v1/config/global needs no
# Authorization header at all — the app reads policy links, the maintenance flag
# and emergency helplines before sign-in.
GLOBAL_CONFIG_CACHE_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# Optional legacy credential (stored locally at the user's request; unused by
# the master spec, which standardises on Google Gemini).
# ---------------------------------------------------------------------------
OMNIROUTE_API_KEY=
